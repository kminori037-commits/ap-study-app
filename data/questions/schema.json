{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ap-study.example/schemas/question-bank.json",
  "title": "AP Study question bank",
  "type": "object",
  "required": ["schemaVersion", "bankId", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bankId": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["questionId", "subject", "group", "category", "prompt", "answer", "source"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
          "subject": { "enum": ["A", "B"] },
          "group": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "choices": { "type": "array", "items": { "type": "string" } },
          "answer": {
            "type": "object",
            "required": ["kind", "explanation"],
            "properties": {
              "kind": { "enum": ["CHOICE", "SHORT"] },
              "correctIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
              "acceptedAnswers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "modelAnswer": { "type": "string" },
              "explanation": { "type": "string", "minLength": 1 }
            }
          },
          "source": {
            "type": "object",
            "required": ["label"],
            "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string" } }
          }
        }
      }
    }
  }
}
